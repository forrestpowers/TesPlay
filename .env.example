# Native launch: node --env-file=.env server/index.js
# Compose reads .env for interpolation. Do not commit the filled .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=4174
DATA_DIR=./data
SERVER_NAME=TesPlay
REMOTE_ENABLED=true

# Local first run. For public use set https://media.example.com
# HTTPS automatically enables secure session cookies; use that exact URL to log in.
PUBLIC_URL=http://127.0.0.1:4174
# Set to 1 only when the sole ingress is a trusted local reverse proxy/tunnel.
TRUST_PROXY=0

# Leave empty to receive a random setup token in the server console before owner creation.
SETUP_TOKEN=
# Leave empty to generate data/encryption.key. Keep that file with database backups.
# Optional alternative: exactly 64 hex characters. Back up this value separately.
ENCRYPTION_KEY=

# Compose-only settings.
APP_HOST_PORT=4174
DATA_VOLUME_NAME=aperture-data
NODE_IMAGE=node:22-bookworm-slim

# FFmpeg converts the audio of AC-3-only live channels.
# Set the binary path when it is not on the PATH; the limit bounds simultaneous live audio conversions.
FFMPEG_PATH=ffmpeg
AUDIO_REMUX_LIMIT=4
# Car mode (optional): a transcoder service on a machine with a GPU converts live
# IPTV channels to 720p at 30 fps (about 3 Mbps) for car screens and mobile data.
# Run Dockerfile.transcoder there and set the same random token on both sides
# (at least 24 characters, e.g. `openssl rand -hex 32`). Leave empty to hide car mode.
TRANSCODER_URL=
TRANSCODER_TOKEN=
# When Pangolin runs on this same server: connect to it over Docker instead (e.g. gerbil).
TRANSCODER_CONNECT_HOST=

# Native YouTube playback is opt-in. Install yt-dlp with its default extras first.
YOUTUBE_ENABLED=false
YT_DLP_PATH=yt-dlp
# Optional Docker youtube profile pins its resolver dependency.
YT_DLP_VERSION=2026.08.19
# Servers on datacenter addresses get YouTube's "Sign in to confirm you're not a bot" check.
# Run the optional pot profile (docker compose --profile pot) and point both services at it:
# YOUTUBE_POT_PROVIDER_URL=http://pot:4416
YOUTUBE_POT_PROVIDER_URL=
# Signed-in YouTube playback through SABR when the TV player path returns no plain URLs: auto (after the anonymous paths fail too), prefer (right away), or off.
YOUTUBE_SABR=auto
# Tallest YouTube video track to play automatically (360, 480, 720 or 1080). 720p30 suits the Tesla browser.
# Viewers can pick another size in the player (Settings > Resolution); it comes straight from YouTube.
YOUTUBE_MAX_HEIGHT=720

# IPTV movies and series are hidden because most providers deliver them as H.265, which the
# car cannot decode without transcoding. Set to 1 to offer them again; with TRANSCODER_URL
# set, titles the browser cannot decode are converted to H.264 by the transcoder.
# IPTV_ON_DEMAND=1

# Optional Google OAuth client of type "TVs and Limited Input devices" for YouTube
# "Sign in on this screen" (device code at google.com/device). Can also be saved per connection.
GOOGLE_TV_CLIENT_ID=
GOOGLE_TV_CLIENT_SECRET=
# Use distinct image tags for a parallel staging installation.
APP_IMAGE=tesplay:local
YOUTUBE_IMAGE=tesplay-youtube:local
